<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DownloadTray.NativeHost</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Produce a single self-contained exe for the native messaging host. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>DownloadTray.NativeHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DownloadTray.Core/DownloadTray.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>
</Project>
