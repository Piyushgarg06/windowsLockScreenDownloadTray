<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DownloadTray.App.ActivityCard.DownloadCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DownloadTray.App.ActivityCard"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Single download card — matches the spec Section 2.2 reference states:
        Active (size known), Active (size unknown), Starting, Completed.
    -->
    <Border Background="{StaticResource SurfaceBgBrush}"
            CornerRadius="10"
            Padding="14,12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- State icon -->
                <ColumnDefinition Width="*" />      <!-- Content -->
                <ColumnDefinition Width="Auto" />   <!-- Percentage -->
            </Grid.ColumnDefinitions>

            <!-- ── State icon ─────────────────────────────────────────── -->
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.Icon}"
                       FontSize="18"
                       VerticalAlignment="Top"
                       Margin="0,2,0,0"
                       Foreground="{StaticResource AccentPrimaryBrush}" />

            <!-- ── Content column ────────────────────────────────────── -->
            <StackPanel Grid.Column="1" Spacing="3">

                <!-- Filename -->
                <TextBlock Text="{x:Bind ViewModel.Filename}"
                           Style="{StaticResource FilenameTextStyle}" />

                <!-- Progress bar (only when total size is known) -->
                <ProgressBar x:Name="ProgressBar"
                             Value="{x:Bind ViewModel.ProgressValue}"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             CornerRadius="2"
                             Visibility="{x:Bind ViewModel.ShowProgressBar, Mode=OneWay}"
                             Foreground="{StaticResource AccentPrimaryBrush}"
                             Background="{StaticResource BorderBrush}" />

                <!-- Bytes line: "4.2 GB / 6.5 GB" or "2.4 GB downloaded" -->
                <TextBlock Text="{x:Bind ViewModel.BytesLine}"
                           Style="{StaticResource BytesTextStyle}" />

                <!-- Speed + ETA row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SpeedText}"
                               Style="{StaticResource SpeedTextStyle}"
                               Visibility="{x:Bind ViewModel.SpeedText, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.EtaText}"
                               Style="{StaticResource EtaTextStyle}" />
                </StackPanel>

            </StackPanel>

            <!-- ── Percentage (right-aligned) ──────────────────────── -->
            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.PercentageText}"
                       Style="{StaticResource PercentageTextStyle}"
                       VerticalAlignment="Top"
                       Margin="0,2,0,0"
                       Visibility="{x:Bind ViewModel.PercentageText, Converter={StaticResource StringToVisibilityConverter}}" />

        </Grid>
    </Border>
</UserControl>
