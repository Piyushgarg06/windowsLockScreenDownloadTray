{
  "manifest_version": 3,
  "name": "DownloadTray - Live Download Activity",
  "version": "1.0.0",
  "description": "Relays active download status to the DownloadTray desktop app via native messaging.",

  "permissions": [
    "downloads",
    "nativeMessaging"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
